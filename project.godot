config_version=5

[application]
config/name="Koi Kingdom"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Autonomous isometric kingdom life simulation."

[autoload]
TimeManager="*res://scripts/autoload/time_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
RelationshipManager="*res://scripts/core/relationship_manager.gd"
KingdomManager="*res://scripts/core/kingdom_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.11, 0.15, 1)
